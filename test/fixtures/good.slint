import { Button } from "std-widgets.slint";
export global Theme {
    out property <color> bg: #ffffff;
    out property <color> ink: #1f2328;
    out property <color> muted: #57606a;
}
export component MainWindow inherits Window {
    title: "下載管理";
    min-width: 640px;
    min-height: 420px;
    default-font-family: "Microsoft JhengHei UI";
    background: Theme.bg;
    Text { text: "開始下載"; color: Theme.ink; font-size: 14px; }
    Text { text: "次要說明"; color: Theme.muted; font-size: 12px; }
    Button { text: "開啟"; icon: @image-url("open.svg"); }
}
component IconTile {
    accessible-role: button;
    accessible-label: "開啟";
    callback clicked;
    TouchArea { clicked => { root.clicked(); } }
}
